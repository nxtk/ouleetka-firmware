#include <physical_layouts.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zephyr,display = &oled;
        zmk,kscan = &kscan0;
    };

    matrix_transform0: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;
//                  | S5  | S4  | S3  | S2  | S1  |  | S1  | S2  | S3  | S4  | S5  |
//            | S11 | S10 | S9  | S8  | S7  | S6  |  | S6  | S7  | S8  | S9  | S10 | S11 |
//            | S17 | S16 | S15 | S14 | S13 | S12 |  | S12 | S13 | S14 | S15 | S16 | S17 |
//                              | S20 | S19 | S18 |  | S18 | S19 | S20 |
    map = <
            RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
    RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
    RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                            RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Ouleetka Layout";
        transform = <&matrix_transform0>;
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100  100   25       0     0     0>
            , <&key_physical_attrs 125 100  200    0       0     0     0>
            , <&key_physical_attrs 125 100  325    0       0     0     0>
            , <&key_physical_attrs 100 100  450   25       0     0     0>
            , <&key_physical_attrs 100 100  550   25       0     0     0>
            , <&key_physical_attrs 100 100 1100   25       0     0     0>
            , <&key_physical_attrs 100 100 1200   25       0     0     0>
            , <&key_physical_attrs 125 100 1300    0       0     0     0>
            , <&key_physical_attrs 125 100 1425    0       0     0     0>
            , <&key_physical_attrs 100 100 1550   25       0     0     0>
            , <&key_physical_attrs 100 125    0   50       0     0     0>
            , <&key_physical_attrs 100 100  100  125       0     0     0>
            , <&key_physical_attrs 125 100  200  100       0     0     0>
            , <&key_physical_attrs 125 100  325  100       0     0     0>
            , <&key_physical_attrs 100 100  450  125       0     0     0>
            , <&key_physical_attrs 100 100  550  125       0     0     0>
            , <&key_physical_attrs 100 100 1100  125       0     0     0>
            , <&key_physical_attrs 100 100 1200  125       0     0     0>
            , <&key_physical_attrs 125 100 1300  100       0     0     0>
            , <&key_physical_attrs 125 100 1425  100       0     0     0>
            , <&key_physical_attrs 100 100 1550  125       0     0     0>
            , <&key_physical_attrs 100 125 1650   50       0     0     0>
            , <&key_physical_attrs 100 125    0  175       0     0     0>
            , <&key_physical_attrs 100 100  100  225       0     0     0>
            , <&key_physical_attrs 125 100  200  200       0     0     0>
            , <&key_physical_attrs 125 100  325  200       0     0     0>
            , <&key_physical_attrs 100 100  450  225       0     0     0>
            , <&key_physical_attrs 100 100  550  225       0     0     0>
            , <&key_physical_attrs 100 100 1100  225       0     0     0>
            , <&key_physical_attrs 100 100 1200  225       0     0     0>
            , <&key_physical_attrs 125 100 1300  200       0     0     0>
            , <&key_physical_attrs 125 100 1425  200       0     0     0>
            , <&key_physical_attrs 100 100 1550  225       0     0     0>
            , <&key_physical_attrs 100 125 1650  175       0     0     0>
            , <&key_physical_attrs 100 100  475  330  (-300)     0     0>
            , <&key_physical_attrs 100 125  585  350     500     0     0>
            , <&key_physical_attrs 100 125  685  375     750     0     0>
            , <&key_physical_attrs 100 125  962  375  (-750)     0     0>
            , <&key_physical_attrs 100 125 1065  350  (-500)     0     0>
            , <&key_physical_attrs 100 100 1175  325     300     0     0>
            ;
    };
};

&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        com-sequential;
        inversion-on;
        prechargep = <0x22>;
    };
};